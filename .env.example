APP_NAME=examate-rag
ENVIRONMENT=local

# Gemini SDK settings used by POST /ask. Never commit the real .env file.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
MODEL_TIMEOUT_SECONDS=15

# OpenAI-compatible Gemini settings used by streaming POST /chat.
# Empty LLM values reuse the corresponding Gemini values above.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=0

COST_LOG_PATH=logs/cost_log.jsonl
# Estimated paid-tier USD rates per million text tokens; adjust for your billing tier.
PRIMARY_INPUT_COST_PER_MILLION=0.30
PRIMARY_OUTPUT_COST_PER_MILLION=2.50
FALLBACK_INPUT_COST_PER_MILLION=0.10
FALLBACK_OUTPUT_COST_PER_MILLION=0.40
